# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Admin credentials — REQUIRED. Login fails if either is unset.
# Use a strong password; do not commit real values to the repo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me-with-a-strong-password

# Optional: Vercel KV for persistent storage
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
